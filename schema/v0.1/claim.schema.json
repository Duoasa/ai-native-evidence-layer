{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-evidence-layer:schema:claim:0.1",
  "title": "Evidence claim",
  "description": "A scoped property-value assertion with provenance and lifecycle state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject_id",
    "predicate",
    "value",
    "status",
    "method",
    "observed_at",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{2,255}$"
    },
    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "value": true,
    "status": {
      "type": "string",
      "enum": ["asserted", "verified", "disputed", "stale", "withdrawn", "unknown"]
    },
    "method": {
      "type": "string",
      "enum": [
        "publisher_statement",
        "deterministic_extraction",
        "ai_extraction",
        "human_review",
        "computed_inference"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "qualifiers": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "reference.schema.json"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9._-]+$"
      },
      "additionalProperties": true
    }
  }
}
