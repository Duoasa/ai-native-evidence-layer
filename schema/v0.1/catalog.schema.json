{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-evidence-layer:schema:catalog:0.1",
  "title": "Evidence catalog snapshot",
  "description": "A deterministic snapshot published by one evidence node.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "snapshot_date", "entities"],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{2,255}$"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "entity.schema.json"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9._-]+$"
      },
      "additionalProperties": true
    }
  }
}
